{
  "name": "Engineering Portfolio",

  "forwardPorts": [5500],

  "portsAttributes": {
    "5500": {
      "label": "Portfolio Preview",
      "onAutoForward": "openPreview"
    }
  },

  "postAttachCommand": {
    "portfolio-server": "python3 -m http.server 5500 --bind 0.0.0.0"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot"
      ]
    },

    "codespaces": {
      "openFiles": [
        "index.html"
      ]
    }
  }
}